int main() {
    char* storedSymbols = NULL;
    int storedSymbolCount = 0;
    char processedConsonants[201] = ""; // Initialize to empty string
    int consonantCount = 0;
    int outputFile = -1; // Initialize to error state

    // Input
    storedSymbols = readSymbolsUntilVowel("f9.txt", &storedSymbolCount);

    // Process
    processStoredSymbols(storedSymbols, storedSymbolCount, processedConsonants, &consonantCount);
